DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
# Optional: register slash commands instantly in one development server.
GUILD_ID=
PREFIX=!
PORT=4010
HOST=0.0.0.0

# Spawning defaults. Per-server channels can also be managed with /spawn-channel.
SPAWN_MIN_MESSAGES=20
SPAWN_MAX_MESSAGES=50
SPAWN_CHANNEL_IDS=

# url-template downloads an image and attaches it to the Discord embed.
# {prompt}, {seed}, {width}, and {height} are replaced automatically.
IMAGE_PROVIDER=url-template
IMAGE_API_URL=https://gen.pollinations.ai/image/{prompt}?model=zimage&seed={seed}&width={width}&height={height}&safe=true
# Pollinations currently requires a server-side key; replace the URL/key for another provider.
IMAGE_API_KEY=your-image-api-key
IMAGE_TIMEOUT_MS=45000

# For a JSON API instead, use IMAGE_PROVIDER=json and set the response path.
# IMAGE_PROVIDER=json
# IMAGE_API_URL=https://your-provider.example/v1/images/generations
# IMAGE_RESPONSE_PATH=data.0.url
# IMAGE_AUTH_HEADER=Authorization
# IMAGE_AUTH_PREFIX=Bearer

DAYCARE_BREED_HOURS=6
DAYCARE_BREED_MESSAGES=150
EGG_HATCH_MINUTES=30
EGG_HATCH_MESSAGES=25
